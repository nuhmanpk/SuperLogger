{
  "name": "superlogger",
  "displayName": "Super Logger",
  "description": "A VS Code extension that enhances debugging in various programming languages by adding print statements with random emojis making the debugging easy.",
  "publisher": "nuhmanpk",
  "icon": "images/logo.png",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.81.0"
  },
  "keywords": [
    "logging",
    "debugging",
    "console",
    "turbo console",
    "multi language",
    "observability"
  ],
  "categories": [
    "Debuggers",
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nuhmanpk/SuperLogger.git"
  },
  "activationEvents": [
    "onCommand:superlogger.addSuperLogger",
    "onCommand:superlogger.nodeLogger",
    "onCommand:superlogger.openWelcome"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "superlogger.addSuperLogger",
        "title": "Add SuperLogger"
      },
      {
        "command": "superlogger.nodeLogger",
        "title": "Comment all Logs"
      },
      {
        "command": "superlogger.openWelcome",
        "title": "SuperLogger: Show Welcome Hub"
      }
    ],
    "configuration": {
      "title": "SuperLogger",
      "properties": {
        "superLogger.showWelcomeMessage": {
          "type": "boolean",
          "default": true,
          "description": "Show a welcome toast the first time SuperLogger activates in a session."
        },
        "superLogger.includeEmoji": {
          "type": "boolean",
          "default": true,
          "description": "Prefix generated logs with random emojis."
        },
        "superLogger.includeFileMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Embed the current file name and line number in generated logs."
        },
        "superLogger.insertJokeComment": {
          "type": "boolean",
          "default": false,
          "description": "Add a comment above each log with a random upbeat message."
        }
      }
    },
    "keybindings": [
      {
        "command": "superlogger.addSuperLogger",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus",
        "title": "Add Super Log"
      },
      {
        "command": "superlogger.nodeLogger",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus",
        "title": "For Node"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.81.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.8.2",
    "typescript": "^5.1.3",
    "@vscode/test-electron": "^2.3.2"
  }
}
